{
  "name": "pillprice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen",
    "snapshot:nadac": "tsx --conditions=react-server scripts/snapshot-nadac.ts",
    "check:openfda-fields": "tsx --conditions=react-server scripts/check-openfda-fields.ts",
    "check:build-degradation": "tsx scripts/check-build-degradation.ts",
    "rehearse:rollover": "tsx --conditions=react-server scripts/rehearse-nadac-rollover.ts",
    "codegen:check": "graphql-codegen --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.1",
    "dataloader": "^2.2.3",
    "graphql": "^17.0.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "playwright": "latest",
    "storybook": "^10.5.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "aria-query": "^5.3.2"
  }
