# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# local agent/editor settings
.claude/settings.local.json

# Agent worktrees are full checkouts, node_modules included — hundreds of MB of
# untracked files sitting inside the repo, where a `git add -A` would try to
# stage every one of them. Scoped to `worktrees/` rather than all of `.claude/`
# so shared agent config stays committable.
.claude/worktrees/

# NADAC snapshot output. The weekly job (ADR-009) writes ~4 MB of price data
# here, superseded every week — a build artifact, not a source of truth.
.data/
